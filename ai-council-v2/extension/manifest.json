{
  "manifest_version": 3,
  "name": "AI Council V2 Agent",
  "version": "2.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*","https://chat.openai.com/*","https://copilot.microsoft.com/*"],
  "background": {"service_worker":"background.js"},
  "action": {"default_popup":"popup.html"},
  "content_scripts": [{"matches":["https://chatgpt.com/*","https://chat.openai.com/*","https://copilot.microsoft.com/*"],"js":["agent.js"],"run_at":"document_idle"}]
}
